{
  "expo": {
    "name": "Compara",
    "slug": "compara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.compara.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6B003",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.compara.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 220,
          "backgroundColor": "#F6B003"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Compara usa a câmera para ler o QR Code do cupom fiscal e o código de barras dos produtos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "scheme": "compara",
    "experiments": {
      "typedRoutes": true
    }
  }
}
